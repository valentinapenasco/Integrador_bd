# Local API connection. Compose provisions bodegas_api with this password.
# Change it for a non-local deployment and keep it outside version control.
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodegas_atuel
DB_USER=bodegas_api
DB_SSLMODE=prefer
# For managed PostgreSQL, use require and optionally set the provider CA path.
# DB_SSLROOTCERT=
DB_POOL_MAX_SIZE=10
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
API_PORT=8000
FRONT_PORT=8080

# Used only by db/seed/seed.py when that separate step is explicitly authorized.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_postgres_password

# Dedicated local test database. It is separate from the main db_data volume.
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=local_test_only_password
TEST_POSTGRES_DB=bodegas_atuel_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://postgres:local_test_only_password@localhost:5433/bodegas_atuel_test
